# Copy to .env and fill in the values: cp .env.example .env
# .env is gitignored. Never commit real keys.

# Gemini API key (Google AI Studio): primary model provider
GEMINI_API_KEY=

# Groq API key: fallback model provider
GROQ_API_KEY=

# Secret key for the id hashes in logs and traces (HMAC-SHA256).
# Run `task env:hash-key` to have one written into .env.
# Without it a random key is made for each run.
LOG_HASH_KEY=

# Where traces go: off (default), phoenix or langfuse. Leave it unset for
# local work and the evaluation; the deployed page sets it among its secrets.
# TRACING_TARGET=off

# Langfuse Cloud keys: only when TRACING_TARGET is "langfuse"
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
